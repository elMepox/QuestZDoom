 void D_DoomLoop ();
 
+#ifdef __ANDROID__
+// --- DoomXR diagnostics: where is the main thread? A watchdog thread logs the last stage once per second. ---
+#include <thread>
+#include <chrono>
+const char * volatile g_doomxrStage = "startup";
+volatile unsigned g_doomxrLoopCount = 0;
+#define XRSTAGE(s) (g_doomxrStage = (s))
+#include "menustate.h"
+static struct DoomxrWatchdog
+{
+	DoomxrWatchdog()
+	{
+		std::thread([]() {
+			unsigned last = 0;
+			for (;;)
+			{
+				std::this_thread::sleep_for(std::chrono::seconds(1));
+				const unsigned now = g_doomxrLoopCount;
+				__android_log_print(ANDROID_LOG_INFO, "DoomXR-XR", "heartbeat: stage=%s loops=%u (+%u) gametic=%d gamestate=%d menuactive=%d tic=%d",
+				                    g_doomxrStage, now, now - last, gametic, (int)gamestate, (int)menuactive, I_GetTime());
+				last = now;
+			}
+		}).detach();
+	}
+} s_doomxrWatchdog;
+#else
+#define XRSTAGE(s) ((void)0)
+#endif
+
