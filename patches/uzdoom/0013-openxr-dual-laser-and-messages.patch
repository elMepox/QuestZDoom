+// Flips a bool option from the controller and says so: on the screen (mid-screen message) and in logcat.
+void XrToggleOption(const char *cvarName, const char *label)
+{
+	FBaseCVar *cv = FindCVar(cvarName, nullptr);
+	if (cv == nullptr) return;
+	UCVarValue v;
+	v.Bool = !cv->GetGenericRep(CVAR_Bool).Bool;
+	cv->SetGenericRep(v, CVAR_Bool);
+	FString msg;
+	msg.Format("%s: %s", label, v.Bool ? "ON" : "OFF");
+	__android_log_print(ANDROID_LOG_INFO, "DoomXR-XR", "%s (%s)", msg.GetChars(), cvarName);
+	C_MidPrint(SmallFont, msg.GetChars());
+}
