 // While a weapon action function runs (A_FireBullets, A_FireProjectile, A_Punch, ...), the local player's actor is
 // moved to the right controller's pose, so hitscans and projectiles start at the hand and follow its aim direction.
 // The actor is put back right afterwards; nothing else sees the temporary pose.
+bool g_xrAimActive = false;	// an XrAimScope is open: P_LineAttack / P_SpawnPlayerMissile log what they receive
+
 struct XrAimScope
 {
 	AActor *mo = nullptr;
@@ -67,6 +72,7 @@ struct XrAimScope
 		DoomXrHand h;
 		if (!xr_get_hand(1, m->X(), m->Y(), p->viewz, m->Angles.Yaw.Degrees(), vr_hunits_per_meter / stretch, stretch, &h)) return;
 		mo = m;
