@@ -79,11 +85,55 @@ struct XrAimScope
 	~XrAimScope()
 	{
 		if (mo == nullptr) return;
+		g_xrAimActive = false;
 		mo->SetXYZ(pos);
 		mo->Angles.Yaw = yaw;
 		mo->Angles.Pitch = pitch;
 	}
 };
+
+// Logs the angles a weapon function really passes on: the hand pose is yaw/pitch of the scope (m->Angles), the shot
+// adds spread and autoaim on top. Differences are in degrees, normalised to -180..180.
+void XrLogShot(const char *what, AActor *m, DAngle angle, DAngle pitch)
+{
+	__android_log_print(ANDROID_LOG_INFO, "DoomXR-Aim", "%s: angle %.1f pitch %.1f (hand yaw %.1f pitch %.1f; d_yaw %.1f d_pitch %.1f) at %.0f,%.0f,%.0f",
+	                    what, angle.Normalized180().Degrees(), pitch.Degrees(), m->Angles.Yaw.Normalized180().Degrees(), m->Angles.Pitch.Degrees(),
+	                    deltaangle(m->Angles.Yaw, angle).Degrees(), (pitch - m->Angles.Pitch).Degrees(), m->X(), m->Y(), m->Z());
+}
+
+CVAR(Bool, vr_aim_laser, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)	// debug: mark with small lights where the shots of the right hand go
+
+// A dotted line from the hand to the point a hitscan from the hand would hit, drawn as short-lived world sprites. It is
+// built inside the same XrAimScope as a shot, so it uses exactly the position and angles the weapon functions see.
+void XrAimLaser(player_t *p)
+{
+	if (!vr_aim_laser) return;
+	XrAimScope aim(p);
+	AActor *m = aim.mo;
+	if (m == nullptr) return;
+	static PClassActor *dot = PClass::FindActor("Candlestick");
+	if (dot == nullptr) return;
+
+	const double range = 4096;
+	const double sz = m->Height * 0.5 + m->AttackOffset();	// Center() - Floorclip + AttackOffset() as in P_LineAttack
+	FLineTraceData tr;
+	const bool hit = P_LineTrace(m, m->Angles.Yaw, range, m->Angles.Pitch, 0, sz, 0, 0, &tr) != 0;
+	const double len = hit ? tr.Distance : range;
+	const double pc = m->Angles.Pitch.Cos();
+	const DVector3 dir(pc * m->Angles.Yaw.Cos(), pc * m->Angles.Yaw.Sin(), -m->Angles.Pitch.Sin());
+	const DVector3 start = m->PosAtZ(m->Z() - m->Floorclip + sz);
+
+	auto put = [&](double dist, double scale)
+	{
+		AActor *d = Spawn(m->Level, dot, start + dir * dist, NO_REPLACE);
+		if (d == nullptr) return;
+		d->flags |= MF_NOGRAVITY;
+		d->Scale = DVector2(scale, scale);
+		d->tics = 2;	// gone after two tics: the next tic draws the line again
+	};
+	for (int i = 1; i <= 10; i++) put(len * i / 11, 0.2);
+	put(len, 0.6);
+}
 #endif
 
 
