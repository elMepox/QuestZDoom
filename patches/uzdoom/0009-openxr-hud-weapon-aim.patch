+EXTERN_CVAR(Float, vr_hunits_per_meter)
+
+// While a weapon action function runs (A_FireBullets, A_FireProjectile, A_Punch, ...), the local player's actor is
+// moved to the right controller's pose, so hitscans and projectiles start at the hand and follow its aim direction.
+// The actor is put back right afterwards; nothing else sees the temporary pose.
+struct XrAimScope
+{
+	AActor *mo = nullptr;
+	DVector3 pos;
+	DAngle yaw, pitch;
+
+	explicit XrAimScope(player_t *p)
+	{
+		if (vr_mode != 15 /*VR_OPENXR*/ || !vr_hand_aim || !xr_is_initialized() || netgame) return;
+		if (p == nullptr || p != &players[consoleplayer] || p->mo == nullptr || (p->cheats & CF_PREDICTING)) return;
+		AActor *m = p->mo;
+		const double stretch = m->Level->info->pixelstretch;
+		DoomXrHand h;
+		if (!xr_get_hand(1, m->X(), m->Y(), p->viewz, m->Angles.Yaw.Degrees(), vr_hunits_per_meter / stretch, stretch, &h)) return;
+		mo = m;
+		pos = m->Pos();
+		yaw = m->Angles.Yaw;
+		pitch = m->Angles.Pitch;
+		// Hitscans and missiles start at Center() - Floorclip + the attack offset: put that point on the hand.
+		const double shootz = m->Center() - m->Floorclip + m->AttackOffset();
+		m->SetXYZ(h.x, h.y, pos.Z + (h.z - shootz));
+		m->Angles.Yaw = DAngle::fromDeg(h.yaw);
+		m->Angles.Pitch = DAngle::fromDeg(h.pitch);
+	}
+	~XrAimScope()
+	{
+		if (mo == nullptr) return;
+		mo->SetXYZ(pos);
+		mo->Angles.Yaw = yaw;
+		mo->Angles.Pitch = pitch;
+	}
+};
+#endif
 
 
