diff --git a/src/rendering/hwrenderer/scene/hw_weapon.cpp b/src/rendering/hwrenderer/scene/hw_weapon.cpp
index 917b73a..0b23d0f 100644
--- a/src/rendering/hwrenderer/scene/hw_weapon.cpp
+++ b/src/rendering/hwrenderer/scene/hw_weapon.cpp
@@ -124,6 +124,78 @@ void HWDrawInfo::DrawPlayerSprites(bool hudModelStep, FRenderState &state)
 }
 
 
+#ifdef DOOMXR_OPENXR
+EXTERN_CVAR(Float, vr_hunits_per_meter)
+EXTERN_CVAR(Float, vr_weapon_scale)
+EXTERN_CVAR(Float, vr_weapon_tilt)
+
+//==========================================================================
+//
+// OpenXR: the weapon sprite is a flat picture attached to the right controller.
+//
+// The sprite vertices are screen pixels (see GetWeaponRect); a matrix maps those to map space instead: the
+// bottom centre of the view window sits on the hand, image-right is the controller's right and image-up is the
+// controller's up tipped towards its aim direction by vr_weapon_tilt degrees.
+//
+//==========================================================================
+
+void HWDrawInfo::DrawXrPlayerSprites(FRenderState &state)
+{
+	if (!xrHandValid) return;
+	bool any = false;
+	for (auto &h : hudsprites)
+		if (!h.mframe && h.weapon && h.weapon->GetID() < PSP_TARGETCENTER) { any = true; break; }
+	if (!any) return;
+
+	const double stretch = Level->info->pixelstretch;
+	const double sh = vr_hunits_per_meter / stretch;	// map units per meter, horizontal (as for the head position)
+	const double sv = sh / stretch;						// ... and vertical
+	const double tilt = DAngle::fromDeg(vr_weapon_tilt).Radians();
+	const double ct = cos(tilt), st = sin(tilt);
+	const DoomXrHand &H = xrHand;
+	// Image up: the hand's up tipped towards its aim direction.
+	double iux = H.ux * ct + H.fx * st, iuy = H.uy * ct + H.fy * st, iuz = H.uz * ct + H.fz * st;
+	const double il = sqrt(iux * iux + iuy * iuy + iuz * iuz);
+	if (il > 1e-6) { iux /= il; iuy /= il; iuz /= il; }
+	// Normal of the picture (facing back towards the player).
+	double nx = H.ry * iuz - H.rz * iuy, ny = H.rz * iux - H.rx * iuz, nz = H.rx * iuy - H.ry * iux;
+
+	// Meters per screen pixel: the view window width spans 0.9 m (times vr_weapon_scale).
+	const double k = 0.9 * vr_weapon_scale / (double)viewwidth;
+	const double ax = viewwindowx + viewwidth * 0.5, ay = viewwindowy + viewheight;
+
+	// Directions in map space -> render space (x, z, y), including the unit conversion.
+	auto cu = [&](double x, double y, double z, double *o) { o[0] = x * sh * k; o[1] = z * sv * k; o[2] = y * sh * k; };
+	double u[3], v[3], n[3];
+	cu(H.rx, H.ry, H.rz, u);
+	cu(iux, iuy, iuz, v);
+	cu(nx, ny, nz, n);
+	float m[16] = {
+		(float)u[0], (float)u[1], (float)u[2], 0.f,
+		(float)-v[0], (float)-v[1], (float)-v[2], 0.f,
+		(float)n[0], (float)n[1], (float)n[2], 0.f,
+		(float)(H.x - ax * u[0] + ay * v[0]), (float)(H.z - ax * u[1] + ay * v[1]), (float)(H.y - ax * u[2] + ay * v[2]), 1.f };
+	VSMatrix model;
+	model.loadMatrix(m);
+
+	HWViewpointUniforms vp = VPUniforms;	// the eye's view and projection
+	vp.mViewMatrix.multMatrix(model);
+	vp.CalcDependencies();
+	screen->mViewpoints->SetViewpoint(state, &vp);
+	state.EnableDepthTest(false);
+	state.EnableMultisampling(false);
+
+	auto oldlightmode = lightmode;
+	if (isSoftwareLighting(oldlightmode)) SetFallbackLightMode();
+	for (auto &hudsprite : hudsprites)
+	{
+		if (hudsprite.mframe || !hudsprite.weapon || hudsprite.weapon->GetID() >= PSP_TARGETCENTER) continue;
+		DrawPSprite(&hudsprite, state);
+	}
+	lightmode = oldlightmode;
+}
+#endif
+
