@@ -153,7 +154,22 @@ void HWDrawInfo::DrawXrPlayerSprites(FRenderState &state)
 	const double sv = sh / stretch;						// ... and vertical
 	const double tilt = DAngle::fromDeg(vr_weapon_tilt).Radians();
 	const double ct = cos(tilt), st = sin(tilt);
-	const DoomXrHand &H = xrHand;
+	DoomXrHand H = xrHand;
+	if (!vr_weapon_roll)
+	{
+		// Wrist roll would swing the sprite's barrel sideways while the shots keep going along the aim direction: use
+		// a frame without roll (image-right stays horizontal), so the barrel always lines up with the aim yaw.
+		double rx = H.fy, ry = -H.fx;
+		const double rl = sqrt(rx * rx + ry * ry);
+		if (rl > 0.2)	// not aiming (nearly) straight up or down
+		{
+			rx /= rl; ry /= rl;
+			H.rx = rx; H.ry = ry; H.rz = 0;
+			H.ux = ry * H.fz;
+			H.uy = -rx * H.fz;
+			H.uz = rx * H.fy - ry * H.fx;
+		}
+	}
 	// Image up: the hand's up tipped towards its aim direction.
 	double iux = H.ux * ct + H.fx * st, iuy = H.uy * ct + H.fy * st, iuz = H.uz * ct + H.fz * st;
 	const double il = sqrt(iux * iux + iuy * iuy + iuz * iuz);
