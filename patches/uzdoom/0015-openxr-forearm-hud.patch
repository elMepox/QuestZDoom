+// ---- interactive forearm HUD ----
+// A panel above the left controller: health, armor, ammo of the ready weapon and the weapon slots. The game draws it
+// into the bottom-left corner of the screen image (its aspect is the panel's 512:192, a quarter of the screen high), the
+// OpenXR side lifts it out onto a quad that follows the left hand. Touching a slot with the right fingertip selects it.
+CVAR(Bool, vr_hud_custom, true, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)			// interactive forearm HUD instead of the status bar
+CVAR(Float, vr_hud_panel_width, 0.3f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)	// width of the forearm HUD, meters
+bool g_xrPanelDrawn = false;
+static int g_xrPanelHover = -1;		// slot under the fingertip (1..7), or -1
+
+static const int XR_PANEL_W = 512, XR_PANEL_H = 192;
+static const int XR_SLOT_FIRST = 1, XR_SLOT_LAST = 7;
+
+static void XrSlotCell(int slot, int *x, int *y, int *w, int *h)
+{
+	*x = 12 + (slot - XR_SLOT_FIRST) * 70;
+	*y = 112;
+	*w = 64;
+	*h = 68;
+}
+
+// Panel units (512x192, origin top-left) -> slot or -1. The whole band under the numbers counts, to make touching easy.
+static int XrSlotAt(float px, float py)
+{
+	if (py < 100.f) return -1;
+	for (int slot = XR_SLOT_FIRST; slot <= XR_SLOT_LAST; slot++)
+	{
+		int x, y, w, h;
+		XrSlotCell(slot, &x, &y, &w, &h);
+		if (px >= x - 3 && px < x + w + 3) return slot;
+	}
+	return -1;
+}
+
+static bool XrSlotOwned(player_t *p, int slot)
+{
+	for (int i = 0, n = p->weapons.SlotSize(slot); i < n; i++)
+	{
+		PClassActor *cls = p->weapons.GetWeapon(slot, i);
+		if (cls != nullptr && p->mo->FindInventory(cls)) return true;
+	}
+	return false;
+}
+
+static int XrReadySlot(player_t *p)
+{
+	if (p->ReadyWeapon == nullptr) return -1;
+	int slot = -1, idx = -1;
+	if (p->weapons.LocateWeapon(static_cast<PClassActor *>(p->ReadyWeapon->GetClass()), &slot, &idx)) return slot;
+	return -1;
+}
+
+void XrDrawPanel()
+{
+	player_t *p = &players[consoleplayer];
+	if (p->mo == nullptr) return;
+	const int sw = twod->GetWidth(), sh = twod->GetHeight();
+	const int rh = sh / 4;
+	int rw = rh * XR_PANEL_W / XR_PANEL_H;
+	if (rw > sw) rw = sw;
+	const int x0 = 0, y0 = sh - rh;
+	const double k = (double)rw / XR_PANEL_W;
+	g_xrPanelDrawn = true;
+
+	auto rect = [&](int ux, int uy, int uw, int uh, PalEntry c, float a)
+	{
+		Dim(twod, c, a, x0 + (int)(ux * k), y0 + (int)(uy * k), (int)(uw * k) + 1, (int)(uh * k) + 1);
+	};
+	auto text = [&](int ux, int uy, double scale, int color, const char *str)
+	{
+		DrawText(twod, SmallFont, color, x0 + ux * k, y0 + uy * k, str, DTA_ScaleX, scale * k, DTA_ScaleY, scale * k, TAG_DONE);
+	};
+
+	rect(0, 0, XR_PANEL_W, XR_PANEL_H, 0x0c1218, 0.78f);
+	rect(0, 0, XR_PANEL_W, 3, 0x5fb4ff, 0.9f);
+	rect(0, XR_PANEL_H - 3, XR_PANEL_W, 3, 0x5fb4ff, 0.9f);
+	rect(0, 0, 3, XR_PANEL_H, 0x5fb4ff, 0.9f);
+	rect(XR_PANEL_W - 3, 0, 3, XR_PANEL_H, 0x5fb4ff, 0.9f);
+
+	// numbers and bars: health, armor, ammo
+	const int health = p->health;
+	AActor *armor = p->mo->FindInventory(NAME_BasicArmor, true);
+	const int armorAmt = armor != nullptr ? armor->IntVar(NAME_Amount) : 0;
+	AActor *ammo = nullptr;
+	if (p->ReadyWeapon != nullptr)
+	{
+		ammo = p->ReadyWeapon->PointerVar<AActor>(NAME_Ammo1);
+		if (ammo == nullptr) ammo = p->ReadyWeapon->PointerVar<AActor>(NAME_Ammo2);
+	}
+	const int ammoAmt = ammo != nullptr ? ammo->IntVar(NAME_Amount) : 0;
+	const int ammoMax = ammo != nullptr ? ammo->IntVar(NAME_MaxAmount) : 0;
+
+	struct Stat { int x; const char *label; int value; int maxv; PalEntry bar; int color; bool show; };
+	const Stat stats[3] = {
+		{14, "HEALTH", health, 100, health > 50 ? PalEntry(0x3ddc5a) : (health > 25 ? PalEntry(0xe8c030) : PalEntry(0xe03030)), health > 25 ? CR_GREEN : CR_RED, true},
+		{184, "ARMOR", armorAmt, 100, PalEntry(0x4a90ff), CR_BLUE, true},
+		{354, "AMMO", ammoAmt, ammoMax, PalEntry(0xe8a030), CR_GOLD, ammo != nullptr},
+	};
+	for (const Stat &st : stats)
+	{
+		text(st.x, 8, 1.0, CR_GRAY, st.label);
+		FString num;
+		if (st.show) num.Format("%d", st.value); else num = "--";
+		text(st.x, 24, 3.0, st.color, num.GetChars());
+		rect(st.x, 78, 144, 12, 0x000000, 0.7f);
+		if (st.show && st.maxv > 0)
+		{
+			int fill = st.value * 144 / st.maxv;
+			if (fill > 144) fill = 144;
+			if (fill > 0) rect(st.x, 78, fill, 12, st.bar, 0.95f);
+		}
+	}
+
+	// weapon slots
+	const int ready = XrReadySlot(p);
+	for (int slot = XR_SLOT_FIRST; slot <= XR_SLOT_LAST; slot++)
+	{
+		int x, y, w, h;
+		XrSlotCell(slot, &x, &y, &w, &h);
+		const bool owned = XrSlotOwned(p, slot);
+		if (slot == ready) rect(x - 3, y - 3, w + 6, h + 6, 0xffe040, 0.95f);
+		rect(x, y, w, h, g_xrPanelHover == slot ? PalEntry(0x5a90c0) : (owned ? PalEntry(0x2a3a4c) : PalEntry(0x151c24)), 0.95f);
+		FString n;
+		n.Format("%d", slot);
+		text(x + 20, y + 14, 3.0, owned ? CR_WHITE : CR_DARKGRAY, n.GetChars());
+	}
+}
+
+// Fingertip over / on the panel (position 0..1, origin top-left): highlights the slot, buzzes the right controller when
+// the finger enters a new one, and on touching a slot it owns selects that weapon.
+void XrPanelInput(int hover, int touch, float u, float v)
+{
+	static int wasTouch = 0;
+	int slot = hover ? XrSlotAt(u * XR_PANEL_W, v * XR_PANEL_H) : -1;
+	if (slot != g_xrPanelHover)
+	{
+		if (slot != -1) xr_haptic(1, 0.25f, 0.02f);
+		g_xrPanelHover = slot;
+	}
+	if (touch && !wasTouch && slot != -1 && players[consoleplayer].mo != nullptr
+		&& XrSlotOwned(&players[consoleplayer], slot))
+	{
+		FString cmd;
+		cmd.Format("slot %d", slot);
+		C_DoCommand(cmd.GetChars());
+		xr_haptic(1, 0.8f, 0.05f);
+		__android_log_print(ANDROID_LOG_INFO, "DoomXR-XR", "HUD touch: %s", cmd.GetChars());
+	}
+	wasTouch = touch;
+}
+
 // Flips a bool option from the controller and says so: on the screen (mid-screen message) and in logcat.
 void XrToggleOption(const char *cvarName, const char *label)
 {
