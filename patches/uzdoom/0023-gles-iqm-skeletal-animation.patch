diff --git a/src/common/rendering/gles/gles_renderstate.cpp b/src/common/rendering/gles/gles_renderstate.cpp
--- a/src/common/rendering/gles/gles_renderstate.cpp
+++ b/src/common/rendering/gles/gles_renderstate.cpp
@@ -352,6 +352,18 @@
 			glUniformMatrix4fv(activeShader->cur->bones_index, number, false, bonesPtr);
 
 			activeShader->cur->muBoneIndexBase.Set(mBoneIndexBase);
+		}
+	}
+	else if (gles.maxBones > 0 && mBoneIndexBase >= 0)
+	{
+		// GLES: the uniform array only holds one model's skeleton, so upload this model's bones from its base
+		float* bonesPtr = ((float*)screen->mBones->GetBuffer()->Memory()) + mBoneIndexBase * 16;
+		int number = int(screen->mBones->GetCurrentIndex()) - mBoneIndexBase;
+		if (number > gles.maxBones) number = gles.maxBones;
+		if (number > 0)
+		{
+			glUniformMatrix4fv(activeShader->cur->bones_index, number, false, bonesPtr);
+			activeShader->cur->muBoneIndexBase.Set(0);
 		}
 	}
 
