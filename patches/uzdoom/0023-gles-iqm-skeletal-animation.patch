diff --git a/src/common/rendering/gles/gles_system.cpp b/src/common/rendering/gles/gles_system.cpp
--- a/src/common/rendering/gles/gles_system.cpp
+++ b/src/common/rendering/gles/gles_system.cpp
@@ -247,7 +247,27 @@
 			gles.useMappedBuffers = true;
 			gles.depthClampAvailable = true;
 			gles.anistropicFilterAvailable = true;
+		}
+
+		if (gles.glesMode == GLES_MODE_GLES)
+		{
+			// GLSL ES 1.00 has no integer attributes and no uniform buffers: the bones go into a plain uniform
+			// array (selectors as float attributes), sized to what the vertex shader has left after the rest
+			// of the uniforms (about 60 vec4).
+#ifndef GL_MAX_VERTEX_UNIFORM_VECTORS
+#define GL_MAX_VERTEX_UNIFORM_VECTORS 0x8DFB
+#endif
+			GLint maxVertexUniforms = 0;
+			glGetIntegerv(GL_MAX_VERTEX_UNIFORM_VECTORS, &maxVertexUniforms);
+			gles.maxBones = (maxVertexUniforms - 80) / 4;
+			if (gles.maxBones < 0) gles.maxBones = 0;
+			if (gles.maxBones > 128) gles.maxBones = 128;
+			Printf("GLES: %d vertex uniform vectors, %d bones for model animation\n", maxVertexUniforms, gles.maxBones);
 		}
+		else
+		{
+			gles.maxBones = gles.numlightvectors;
+		}
 
 		setGlVersion(glVersion);
 	}
