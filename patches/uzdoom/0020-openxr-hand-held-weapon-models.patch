+//==========================================================================
+//
+// OpenXR: a weapon with a MODELDEF entry is drawn as a 3D model held by the controller.
+//
+// RenderHUDModel() places a model relative to the eye (+x right, +y up, -z forward, model x pointing forward);
+// here that frame is replaced by the hand's: origin on the controller, forward along its aim direction (tipped by
+// vr_weapon_model_pitch), up from the controller (the full controller rotation unless vr_weapon_model_roll is off). One model unit is one meter
+// times vr_weapon_model_scale; MODELDEF Scale/Offset apply on top. The model is drawn with the eye's real view
+// and projection over a cleared depth buffer, so it is lit by the level and hidden behind nothing.
+//
+//==========================================================================
+
+void HWDrawInfo::DrawXrHandModels(FRenderState &state, const DoomXrHand &hand, bool left)
+{
+	bool any = false;
+	for (auto &h : hudsprites)
+		if (h.mframe && h.weapon && h.weapon->GetID() < PSP_TARGETCENTER && XrIsLeftLayer(h) == left) { any = true; break; }
+	if (!any) return;
+
+	const double stretch = Level->info->pixelstretch;
+	const double sh = vr_hunits_per_meter / stretch;	// map units per meter, horizontal (as for the head position)
+	const double sv = sh / stretch;						// ... and vertical
+	const double k = vr_weapon_model_scale;
+	DoomXrHand H = hand;
+	XrLevelHandFrame(H, vr_weapon_model_roll);
+	// Aim direction tipped up by the pitch offset; image up follows.
+	const double pitch = DAngle::fromDeg(vr_weapon_model_pitch).Radians();
+	const double cp = cos(pitch), sp = sin(pitch);
+	const double fx = H.fx * cp + H.ux * sp, fy = H.fy * cp + H.uy * sp, fz = H.fz * cp + H.uz * sp;
+	const double ux = H.ux * cp - H.fx * sp, uy = H.uy * cp - H.fy * sp, uz = H.uz * cp - H.fz * sp;
+
+	// Map-space directions -> render space (x, z, y), including the unit conversion. The model's +z is back.
+	auto cu = [&](double x, double y, double z, double *o) { o[0] = x * sh * k; o[1] = z * sv * k; o[2] = y * sh * k; };
+	double r[3], u[3], b[3];
+	cu(H.rx, H.ry, H.rz, r);
+	cu(ux, uy, uz, u);
+	cu(-fx, -fy, -fz, b);
+	float m[16] = {
+		(float)r[0], (float)r[1], (float)r[2], 0.f,
+		(float)u[0], (float)u[1], (float)u[2], 0.f,
+		(float)b[0], (float)b[1], (float)b[2], 0.f,
+		(float)H.x, (float)H.z, (float)H.y, 1.f };
+	VSMatrix handToWorld;
+	handToWorld.loadMatrix(m);
+
+	screen->mViewpoints->SetViewpoint(state, &VPUniforms);	// the eye's view and projection
+	state.SetDepthMask(true);	// glClear leaves the depth buffer alone while the depth mask is off
+	state.Clear(CT_Depth);
+	state.EnableDepthTest(true);
+	state.EnableMultisampling(false);
+	state.EnableFog(false);
+
+	auto oldlightmode = lightmode;
+	if (isSoftwareLighting(oldlightmode)) SetFallbackLightMode();
+	xrHudModelToWorld = &handToWorld;
+	screen->mBones->Map();
+	int drawn = 0, layers[8] = {};
+	for (auto &hudsprite : hudsprites)
+	{
+		if (!hudsprite.mframe || !hudsprite.weapon || hudsprite.weapon->GetID() >= PSP_TARGETCENTER) continue;
+		if (XrIsLeftLayer(hudsprite) != left) continue;
+		if (drawn < 8) layers[drawn] = hudsprite.weapon->GetID();
+		drawn++;
+		DrawPSprite(&hudsprite, state);
+	}
+	if (xr_trace())
+		xr_log("hand model %s: di %p, %d layer(s) %d %d %d, pos %.1f %.1f %.1f fwd %.2f %.2f %.2f up %.2f %.2f %.2f, view origin %.2f %.2f %.2f", left ? "left" : "right",
+			(void *)this, drawn, layers[0], layers[1], layers[2], H.x, H.y, H.z, H.fx, H.fy, H.fz, H.ux, H.uy, H.uz,
+			VPUniforms.mViewMatrix.get()[12], VPUniforms.mViewMatrix.get()[13], VPUniforms.mViewMatrix.get()[14]);
+	screen->mBones->Unmap();
+	xrHudModelToWorld = nullptr;
+	lightmode = oldlightmode;
+	state.EnableDepthTest(false);
+	state.SetDepthMask(false);
+}
 #endif
 
