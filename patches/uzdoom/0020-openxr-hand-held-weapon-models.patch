+// Wrist roll would swing a weapon's barrel sideways while the shots keep going along the aim direction: unless
+// the roll option is on, use a frame without roll (right stays horizontal), so the barrel always lines up with the aim yaw.
+static void XrLevelHandFrame(DoomXrHand &H, bool followRoll)
+{
+	if (followRoll) return;
+	double rx = H.fy, ry = -H.fx;
+	const double rl = sqrt(rx * rx + ry * ry);
+	if (rl > 0.2)	// not aiming (nearly) straight up or down
+	{
+		rx /= rl; ry /= rl;
+		H.rx = rx; H.ry = ry; H.rz = 0;
+		H.ux = ry * H.fz;
+		H.uy = -rx * H.fz;
+		H.uz = rx * H.fy - ry * H.fx;
+	}
+}
