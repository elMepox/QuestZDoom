+
+	// The OpenXR side draws the beam from the controller along its aim; it needs the length in meters. Map units per
+	// meter are vr_hunits_per_meter / stretch horizontally (see xr_get_hand), and the vertical part is stretched.
+	const double stretch = m->Level->info->pixelstretch;
+	const double upm = vr_hunits_per_meter / stretch;
+	const double pc = m->Angles.Pitch.Cos(), sn = m->Angles.Pitch.Sin();
+	const double meters = len / upm * sqrt(pc * pc + sn * sn * stretch * stretch);
+	xr_laser_set(hand, (float)meters, hand == 0 ? 0x40A0FF : 0xFFD83A, vr_aim_laser_start);
