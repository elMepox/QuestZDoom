 static void XrAimLaserHand(player_t *p, int hand)
 {
 	XrAimScope aim(p, hand);
 	AActor *m = aim.mo;
 	if (m == nullptr) return;
-	static PClassActor *dot = PClass::FindActor("Candlestick");
-	if (dot == nullptr) return;
 
 	const double range = 4096;
 	const double sz = m->Height * 0.5 + m->AttackOffset();	// Center() - Floorclip + AttackOffset() as in P_LineAttack
 	FLineTraceData tr;
 	const bool hit = P_LineTrace(m, m->Angles.Yaw, range, m->Angles.Pitch, 0, sz, 0, 0, &tr) != 0;
 	const double len = hit ? tr.Distance : range;
-	const double pc = m->Angles.Pitch.Cos();
-	const DVector3 dir(pc * m->Angles.Yaw.Cos(), pc * m->Angles.Yaw.Sin(), -m->Angles.Pitch.Sin());
-	const DVector3 start = m->PosAtZ(m->Z() - m->Floorclip + sz);
-
-	auto put = [&](double dist, double scale)
-	{
-		AActor *d = Spawn(m->Level, dot, start + dir * dist, NO_REPLACE);
-		if (d == nullptr) return;
-		d->flags |= MF_NOGRAVITY;
-		d->Scale = DVector2(scale, scale);
