+// Teleport: stick forward starts aiming, release jumps (fade out, move, fade in). An unusable aim just cancels.
+static int tpState = 0;				// 0 idle, 1 aiming, 2 fading out, 3 fading in
+static uint64_t tpT0 = 0;
+static double tpDest[3];
+static const uint64_t TP_FADE_OUT_MS = 110, TP_FADE_IN_MS = 160;
+
+static void XrTeleportTick(float stickY, float stickX)
+{
+	player_t *pl = &players[consoleplayer];
+	const uint64_t now = I_msTime();
+	if (pl->mo == nullptr || pl->health <= 0) { tpState = 0; return; }
+	switch (tpState)
+	{
+	case 0:
+		if (stickY > 0.7f && fabsf(stickX) < 0.7f) tpState = 1;
+		break;
+	case 1:
+	{
+		float tEnd;
+		const bool ok = XrTeleportAimUpdate(pl, &tEnd, tpDest);
+		xr_teleport_arc(0, ok, tEnd);
+		if (stickY < 0.3f)
+		{
+			if (ok) { tpState = 2; tpT0 = now; xr_haptic(0, 0.4f, 0.04f); }
+			else tpState = 0;
+		}
+		break;
+	}
+	case 2:
+	{
+		const float a = (float)(now - tpT0) / (float)TP_FADE_OUT_MS;
+		xr_fade_set(a > 1.f ? 1.f : a);
+		if (a >= 1.f)
+		{
+			XrTeleportGo(pl, tpDest);
+			tpState = 3;
+			tpT0 = now;
+		}
+		break;
+	}
+	case 3:
+	{
+		const float a = 1.f - (float)(now - tpT0) / (float)TP_FADE_IN_MS;
+		if (a <= 0.f) tpState = 0;
+		else xr_fade_set(a);
+		break;
+	}
+	}
+}
