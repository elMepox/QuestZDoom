+// ---- teleport locomotion ----
+// The left controller throws an arc (launch speed and gravity from xr_vr.h, so the OpenXR side draws the same curve);
+// where it meets the floor is the destination. The caller (i_input.cpp) fades the view and then calls XrTeleportGo.
+// Returns whether the destination is usable: a step up of at most 48 units, room for the player, nothing solid between.
+bool XrTeleportAimUpdate(player_t *p, float *tEnd, double *dest)
+{
+	*tEnd = 0.f;
+	AActor *m = p->mo;
+	if (m == nullptr) return false;
+	const double stretch = m->Level->info->pixelstretch;
+	const double upm = vr_hunits_per_meter / stretch;
+	DoomXrHand h;
+	if (!xr_get_hand(0, m->X(), m->Y(), p->viewz, m->Angles.Yaw.Degrees(), upm, stretch, &h)) return false;
+
+	const double S = XR_TELEPORT_SPEED, G = XR_TELEPORT_GRAVITY;
+	auto at = [&](double t) {
+		return DVector3(h.x + upm * h.fx * S * t, h.y + upm * h.fy * S * t, h.z + upm / stretch * (h.fz * S * t - 0.5 * G * t * t));
+	};
+	auto floorAt = [&](const DVector3 &v) { return m->Level->PointInSector(v.XY())->floorplane.ZatPoint(v.XY()); };
+	auto ceilAt = [&](const DVector3 &v) { return m->Level->PointInSector(v.XY())->ceilingplane.ZatPoint(v.XY()); };
+
+	const double dt = 0.025, tMax = 2.5;
+	double lo = 0, hi = -1;
+	bool blockedByCeiling = false;
+	for (double t = dt; t <= tMax; t += dt)
+	{
+		const DVector3 v = at(t);
+		if (v.Z > ceilAt(v)) { *tEnd = (float)t; blockedByCeiling = true; break; }
+		if (v.Z <= floorAt(v)) { hi = t; break; }
+		lo = t;
+	}
+	if (hi < 0)
+	{
+		if (!blockedByCeiling) *tEnd = (float)tMax;
+		return false;
+	}
+	for (int i = 0; i < 8; i++)
+	{
+		const double mid = 0.5 * (lo + hi);
+		const DVector3 v = at(mid);
+		if (v.Z <= floorAt(v)) hi = mid; else lo = mid;
+	}
+	DVector3 d = at(hi);
+	d.Z = floorAt(d);
+	*tEnd = (float)hi;
+	dest[0] = d.X; dest[1] = d.Y; dest[2] = d.Z;
+
+	if (d.Z - m->Z() > 48.) return false;
+
+	// Nothing solid between the eye and the destination (the arc itself may pass over low obstacles).
+	{
+		const double sz = p->viewheight;
+		const DVector3 from = m->PosAtZ(m->Z() - m->Floorclip + sz);
+		const DVector3 to(d.X, d.Y, d.Z + sz);
+		const DVector3 delta = to - from;
+		const double hd = delta.XY().Length();
+		const double dist = delta.Length();
+		FLineTraceData tr;
+		if (dist > 1.)
+		{
+			const DAngle ang = VecToAngle(delta.X, delta.Y);
+			const DAngle pitch = -VecToAngle(hd, delta.Z);
+			if (P_LineTrace(m, ang, dist, pitch, 0, sz, 0, 0, &tr) && tr.HitType != TRACE_HitNone && tr.Distance < dist - 2.)
+				return false;
+		}
+	}
+
+	// Room for the player at the destination.
+	const double savedZ = m->Z();
+	m->SetZ(d.Z);
+	FCheckPosition tm;
+	const bool fits = P_CheckPosition(m, d.XY(), tm);
+	m->SetZ(savedZ);
+	if (!fits || tm.floorz - savedZ > 48. || tm.ceilingz - tm.floorz < m->Height) return false;
+	dest[2] = tm.floorz;
+	return true;
+}
+
+void XrTeleportGo(player_t *p, const double *dest)
+{
+	AActor *m = p->mo;
+	if (m == nullptr) return;
+	if (P_TeleportMove(m, DVector3(dest[0], dest[1], dest[2]), false))
+	{
+		m->Vel.Zero();
+		m->ClearInterpolation();
+	}
+}
