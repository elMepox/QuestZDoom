+
 bool M_SetSpecialMenu(FName& menu, int param)
 {
+#ifdef DOOMXR_OPENXR
+	// "Return to library": hands control back to the Android mod library panel.
+	if (menu == FName("DoomXRLibrary"))
+	{
+		xr_open_library();
+		return false;
+	}
+#endif
 	// some menus need some special treatment
 	switch (menu.GetIndex())
 	{
