diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 53beadc..8624f93 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -456,6 +456,11 @@ else()
 	if ( SYSTEMINSTALL )
 		add_definitions( -DPROGDIR="${CMAKE_INSTALL_PREFIX}/${INSTALL_PK3_PATH}" )
 	endif()
+
+	if( ANDROID )
+		# The crash catcher relies on glibc-only facilities; Android has its own tombstones.
+		list( REMOVE_ITEM SYSTEM_SOURCES common/platform/posix/sdl/crashcatcher.c )
+	endif()
 endif()
 
 if( HAVE_MMX )
@@ -1275,7 +1280,12 @@ set( GAME_SOURCES
 set( GAME_NONPCH_SOURCES ${GAME_SOURCES} )
 list( REMOVE_ITEM GAME_NONPCH_SOURCES ${PCH_SOURCES} )
 
-add_executable( zdoom MACOSX_BUNDLE ${GAME_SOURCES} )
+if( ANDROID )
+	# Android loads the game as a shared library (SDL's SDLActivity dlopen()s libmain.so and calls SDL_main)
+	add_library( zdoom SHARED ${GAME_SOURCES} )
+else()
+	add_executable( zdoom MACOSX_BUNDLE ${GAME_SOURCES} )
+endif()
 
 target_include_directories( zdoom PRIVATE ${CMAKE_BINARY_DIR} )
 
