+bool g_xrLeftCtx = false;	// a left-hand weapon action runs: SetPsprite on the weapon layers goes to the left layers instead
+
+CVAR(Bool, vr_dual_wield, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)	// the left trigger fires a second copy of the weapon from the left hand
+
+static bool XrIsReadyState(const FState *st)
+{
+	return st != nullptr && st->ActionFunc != nullptr && strstr(st->ActionFunc->PrintableName, "A_WeaponReady") != nullptr;
+}
+
+// While the left layer's action functions run, the left trigger takes the place of the fire button, so A_ReFire and
+// friends behave as for the right hand (P_SetPsprite sends the layers they set to the left ones).
+struct XrLeftCtx
+{
+	player_t *p = nullptr;
+	int buttons = 0;
+	bool wasOn = false;
+
+	XrLeftCtx(player_t *pl, bool on)
+	{
+		if (!on) return;
+		p = pl;
+		wasOn = g_xrLeftCtx;	// the left layer's actions can start further left states
+		g_xrLeftCtx = true;
+		buttons = p->cmd.buttons;
+		DoomXrInput in;
+		const bool trig = xr_input_poll(&in) && in.trigger[0] > 0.5f;
+		p->cmd.buttons = (buttons & ~(BT_ATTACK | BT_ALTATTACK)) | (trig ? BT_ATTACK : 0);
+	}
+	~XrLeftCtx()
+	{
+		if (p == nullptr) return;
+		g_xrLeftCtx = wasOn;
+		p->cmd.buttons = buttons;
+	}
+};
+
+static bool XrDualActive(player_t *p)
+{
+	return vr_dual_wield && vr_mode == 15 /*VR_OPENXR*/ && xr_is_initialized() && !netgame && p == &players[consoleplayer] &&
+	       p->mo != nullptr && p->health > 0 && p->ReadyWeapon != nullptr && p->PendingWeapon == WP_NOCHANGE && !(p->cheats & CF_PREDICTING);
+}
+
+// Once per tic: keeps the left layer in step with the right-hand weapon and starts a left shot on the left trigger.
+void XrDualTick(player_t *p)
+{
+	DPSprite *left = p->FindPSprite(PSP_LEFT);
+	if (!XrDualActive(p) || (left != nullptr && left->GetCaller() != p->ReadyWeapon))
+	{
+		if (p->cheats & CF_PREDICTING) return;
+		if (left != nullptr) left->Destroy();
+		if (DPSprite *f = p->FindPSprite(PSP_LEFTFLASH)) f->Destroy();
+		return;
+	}
+	if (left == nullptr)
+	{
+		// Appear with the right hand's weapon once it is ready (not while it is being raised).
+		DPSprite *right = p->FindPSprite(PSP_WEAPON);
+		if (right != nullptr && XrIsReadyState(right->GetState()))
+		{
+			XrLeftCtx ctx(p, true);
+			P_SetPsprite(p, PSP_LEFT, right->GetState(), false);
+		}
+		return;
+	}
+	if (!XrIsReadyState(left->GetState())) return;	// still firing
+	DoomXrInput in;
+	if (!xr_input_poll(&in) || in.trigger[0] <= 0.5f) return;
+	XrLeftCtx ctx(p, true);
+	p->refire = 0;
+	IFVIRTUALPTRNAME(p->mo, NAME_PlayerPawn, FireWeapon)
+	{
+		VMValue params[2] = { p->mo, (FState *)nullptr };
+		VMCall(func, params, 2, nullptr, 0);
+	}
+}
