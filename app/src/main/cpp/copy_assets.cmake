# usage: cmake -DSRC=<engine output dir> -DDST=<asset dir> -P copy_assets.cmake
file(MAKE_DIRECTORY "${DST}")
file(GLOB _pk3s "${SRC}/*.pk3")
foreach(_f IN LISTS _pk3s)
  file(COPY "${_f}" DESTINATION "${DST}")
endforeach()
foreach(_d soundfonts fm_banks)
  if(EXISTS "${SRC}/${_d}")
    file(COPY "${SRC}/${_d}" DESTINATION "${DST}")
  endif()
endforeach()
